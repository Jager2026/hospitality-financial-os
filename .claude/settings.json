{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "env": {
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(stripe *)",
      "Bash(railway *)",
      "Bash(prisma migrate deploy *)",
      "Bash(npx prisma migrate deploy *)",
      "Bash(pnpm prisma:migrate:deploy *)",
      "Bash(pnpm run prisma:migrate:deploy *)",
      "Bash(pnpm --filter backend run prisma:migrate:deploy *)",
      "Bash(prisma migrate dev *)",
      "Bash(npx prisma migrate dev *)",
      "Bash(pnpm db:reset *)",
      "Bash(pnpm run db:reset *)",
      "Bash(pnpm --filter backend run db:reset *)"
    ],
    "deny": [
      "Bash(prisma migrate reset *)",
      "Bash(npx prisma migrate reset *)",
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./apps/backend/.env)",
      "Read(**/.env)",
      "Read(**/.env.local)"
    ]
  }
}
