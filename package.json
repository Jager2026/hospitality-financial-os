{
  "name": "hospitality-operating-system",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --parallel --filter=./apps/* run dev",
    "build": "pnpm --recursive --filter=./apps/* --filter=./packages/* run build",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test",
    "prisma:generate": "pnpm --filter backend run prisma:generate",
    "prisma:validate": "pnpm --filter backend run prisma:validate",
    "prisma:migrate:deploy": "pnpm --filter backend run prisma:migrate:deploy"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "multer": "^2.2.0",
      "lodash": "^4.18.0",
      "postcss": "^8.5.18",
      "body-parser": "^1.20.6",
      "qs": "^6.15.2",
      "uuid": "^11.1.1",
      "file-type": "^21.3.2"
    }
  }
}
