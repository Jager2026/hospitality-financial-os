# Copy to .env and fill in real values. Never commit .env.

# Database (matches docker/docker-compose.yml for local dev)
DATABASE_URL="postgresql://hospitality:hospitality@localhost:5432/hospitality_os"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth (Sprint 2) — generate real values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Access and refresh secrets must be different from each other.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_SECONDS="604800"

# Stripe (Sprint 3/5) — see ADR-009, ADR-012, ADR-014
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email provider (Sprint 15) — Resend, see ADR-069. Required: the whole email path hangs from
# this key, so it is not optional and has no default. Fill it before booting; an empty value fails
# the shape check at startup exactly as an absent one does, which is deliberate.
# A real key has the shape re_<publicId>_<secret> — note the underscore INSIDE the body, which
# is what a regex copied from the Stripe rule next door would reject.
RESEND_API_KEY=""

# Platform fee (Sprint 5) — basis points out of 10,000 (100 = 1.00%), a business decision, never
# defaulted silently. See ARCHITECTURE_DECISIONS.md's ADR-014 addendum.
DEFAULT_PLATFORM_FEE_BASIS_POINTS=""

# App
NODE_ENV="development"
PORT="3001"

# Where the browser is sent back after Stripe onboarding (Account Links refresh_url/return_url).
# Has a localhost default in code, so the app boots without this line — which is exactly why it is
# listed here. In production a loopback value is REJECTED at boot (ADR-045): it would send a real
# restaurant owner to their own machine at the last step before they can take payments, silently.
FRONTEND_URL="http://localhost:3000"

# CORS (Sprint 11) — comma-separated allowed Origins. Dev value matches FRONTEND_URL above;
# production must be the real deployed frontend origin, never a wildcard.
CORS_ORIGIN="http://localhost:3000"

# Alerting (Sprint 13, ADR-031) — any endpoint accepting a plain JSON POST; Slack and Discord
# incoming webhooks both work as-is.
#
# Left COMMENTED OUT on purpose, and the reason is a trap worth knowing: the variable is optional
# locally, but `ALERT_WEBHOOK_URL=""` is not the same as unset — an empty string fails the URL rule
# and the app refuses to boot with `ALERT_WEBHOOK_URL: Invalid url`. Optional means absent, not
# blank. (Verified, after nearly shipping the blank version of this very line.)
#
# REQUIRED in production, where the app refuses to boot without it (ADR-045). Since main.ts began
# reporting-and-continuing after an unhandled rejection rather than exiting, this channel is what
# makes a surviving-but-degraded process visible — and AlertService returns silently when it is
# unset, so losing it would switch off every alert with nothing anywhere reporting that it had.
# ALERT_WEBHOOK_URL="https://hooks.slack.com/services/..."
