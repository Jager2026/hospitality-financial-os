# Copy to .env and fill in real values. Never commit .env.

# Database (matches docker/docker-compose.yml for local dev)
DATABASE_URL="postgresql://hospitality:hospitality@localhost:5432/hospitality_os"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth (Sprint 2) — generate real values with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Access and refresh secrets must be different from each other.
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_TTL_SECONDS="900"
JWT_REFRESH_TTL_SECONDS="604800"

# Stripe (Sprint 3/5) — see ADR-009, ADR-012, ADR-014
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# App
NODE_ENV="development"
PORT="3001"
